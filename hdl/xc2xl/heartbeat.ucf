# XC2C256. JP7 connects the oscillator to pin 38 (XCCLK).
# LD2 is package pin 92, function block I/O FB15_16, active low.
# io[0] is J4 pin 5. io[35] is J4 pin 40. Pins 1-3 are power. Pin 4 is GSR.
NET "clk" LOC = "P38";
NET "clk" IOSTANDARD = LVCMOS33;
NET "clk" PERIOD = 542.535 ns;
NET "led" LOC = "P92";
NET "led" IOSTANDARD = LVCMOS33;

# J4 pin 5, B5
NET "io<0>" LOC = "P142";
# J4 pin 6, B6
NET "io<1>" LOC = "P140";
# J4 pin 7, B7
NET "io<2>" LOC = "P139";
# J4 pin 8, B8
NET "io<3>" LOC = "P138";
# J4 pin 9, B9
NET "io<4>" LOC = "P137";
# J4 pin 10, B10
NET "io<5>" LOC = "P136";
# J4 pin 11, B11
NET "io<6>" LOC = "P135";
# J4 pin 12, B12
NET "io<7>" LOC = "P134";
# J4 pin 13, B13
NET "io<8>" LOC = "P133";
# J4 pin 14, B14
NET "io<9>" LOC = "P132";
# J4 pin 15, B15
NET "io<10>" LOC = "P131";
# J4 pin 16, B16
NET "io<11>" LOC = "P130";
# J4 pin 17, B17
NET "io<12>" LOC = "P129";
# J4 pin 18, B18
NET "io<13>" LOC = "P128";
# J4 pin 19, B19
NET "io<14>" LOC = "P126";
# J4 pin 20, B20
NET "io<15>" LOC = "P125";
# J4 pin 21, B21
NET "io<16>" LOC = "P124";
# J4 pin 22, B22
NET "io<17>" LOC = "P121";
# J4 pin 23, B23
NET "io<18>" LOC = "P120";
# J4 pin 24, B24
NET "io<19>" LOC = "P119";
# J4 pin 25, B25
NET "io<20>" LOC = "P118";
# J4 pin 26, B26
NET "io<21>" LOC = "P117";
# J4 pin 27, B27
NET "io<22>" LOC = "P116";
# J4 pin 28, B28
NET "io<23>" LOC = "P115";
# J4 pin 29, B29
NET "io<24>" LOC = "P114";
# J4 pin 30, B30
NET "io<25>" LOC = "P113";
# J4 pin 31, B31
NET "io<26>" LOC = "P112";
# J4 pin 32, B32
NET "io<27>" LOC = "P111";
# J4 pin 33, B33
NET "io<28>" LOC = "P110";
# J4 pin 34, B34
NET "io<29>" LOC = "P107";
# J4 pin 35, B35
NET "io<30>" LOC = "P106";
# J4 pin 36, B36
NET "io<31>" LOC = "P105";
# J4 pin 37, B37
NET "io<32>" LOC = "P104";
# J4 pin 38, B38
NET "io<33>" LOC = "P103";
# J4 pin 39, B39
NET "io<34>" LOC = "P102";
# J4 pin 40, B40
NET "io<35>" LOC = "P101";

NET "io<*>" IOSTANDARD = LVCMOS33;
